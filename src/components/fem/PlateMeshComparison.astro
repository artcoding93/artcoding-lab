---
// 연속체와 유한요소 분할 비교 (구멍이 있는 판). 빌드할 때 SVG로 그리며 브라우저 JS는 없다.
// - 왼쪽(연속체): 외곽선과 구멍 경계만 그린다. 내부 선은 그리지 않는다.
// - 오른쪽(메시): 같은 판을 삼각형 요소로 나눈다. 구멍 경계는 원 위의 절점을 잇는 직선 변으로 근사된다.
// 사용법 (MDX): <PlateMeshComparison label="…">캡션 문장</PlateMeshComparison>
import { plateWithHoleMesh } from '../../lib/fem/plate-with-hole-mesh';
import { fmt } from '../../lib/plot/svg';

interface Props {
  /** 그림 전체의 접근성 라벨 */
  label: string;
  accent?: string;
}

const { label, accent = '#9333ea' } = Astro.props;

const plate = { width: 2, height: 1, radius: 0.25 };
const mesh = plateWithHoleMesh(plate, { segmentsX: 12, segmentsY: 6, rings: 5, grading: 1.3 });

// 판 좌표(원점 중심, y 위쪽) → SVG 좌표
const SCALE = 200;
const MARGIN = 8;
const width = plate.width * SCALE + 2 * MARGIN;
const height = plate.height * SCALE + 2 * MARGIN;
const sx = (x: number) => MARGIN + (x + plate.width / 2) * SCALE;
const sy = (y: number) => MARGIN + (plate.height / 2 - y) * SCALE;
const pt = ([x, y]: [number, number]) => `${fmt(sx(x))},${fmt(sy(y))}`;

const outline = `M${fmt(sx(-1))},${fmt(sy(0.5))}H${fmt(sx(1))}V${fmt(sy(-0.5))}H${fmt(sx(-1))}Z`;

// 연속체: 실제 원형 구멍 (evenodd로 판에서 뺀다)
const r = plate.radius * SCALE;
const cx = sx(0);
const cy = sy(0);
const circle = `M${fmt(cx + r)},${fmt(cy)}A${fmt(r)},${fmt(r)} 0 1 0 ${fmt(cx - r)},${fmt(cy)}A${fmt(r)},${fmt(r)} 0 1 0 ${fmt(cx + r)},${fmt(cy)}Z`;

// 메시: 구멍 경계는 절점을 잇는 다각형
const holePolygon = `M${mesh.holeNodes.map((i) => pt(mesh.nodes[i])).join('L')}Z`;

// 요소 변 (공유 변은 한 번만 그린다)
const edgeSet = new Set<string>();
const edgeParts: string[] = [];
for (const tri of mesh.triangles) {
  for (let k = 0; k < 3; k++) {
    const a = tri[k];
    const b = tri[(k + 1) % 3];
    const key = a < b ? `${a}-${b}` : `${b}-${a}`;
    if (edgeSet.has(key)) continue;
    edgeSet.add(key);
    edgeParts.push(`M${pt(mesh.nodes[a])}L${pt(mesh.nodes[b])}`);
  }
}
const edges = edgeParts.join('');
---

<figure class="plate-compare not-content" style={`--plate-accent: ${accent}`} aria-label={label}>
  <div class="plate-compare__panels">
    <div class="plate-compare__panel">
      <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label="연속체: 원형 구멍이 있는 판. 외곽선과 구멍 경계만 있고 내부 선은 없다.">
        <path class="plate-material" fill-rule="evenodd" d={`${outline}${circle}`} />
        <path class="plate-boundary" d={outline} />
        <path class="plate-boundary" d={circle} />
      </svg>
      <p class="plate-compare__label"><strong>연속체</strong> <span lang="en">Continuum</span></p>
    </div>
    <div class="plate-compare__panel">
      <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`유한요소 메시: 같은 판을 삼각형 요소 ${mesh.triangles.length}개로 나눈 그림. 요소는 구멍 경계와 외곽 경계에 맞춰 배치된다.`}>
        <path class="plate-material" fill-rule="evenodd" d={`${outline}${holePolygon}`} />
        <path class="plate-mesh" d={edges} />
        <path class="plate-boundary" d={outline} />
        <path class="plate-boundary" d={holePolygon} />
      </svg>
      <p class="plate-compare__label"><strong>유한요소 메시</strong> <span lang="en">Mesh</span></p>
    </div>
  </div>
  <figcaption>
    <slot />
    <span class="plate-compare__note">
      개념도: 설명을 위해 단순한 규칙으로 만든 삼각형 분할(요소 {mesh.triangles.length}개, 절점 {mesh.nodes.length}개)이며, 해석용 메시 생성 결과가 아닙니다.
      오른쪽 그림의 구멍 경계는 원 위의 절점을 잇는 짧은 직선 변으로 근사됩니다.
    </span>
  </figcaption>
</figure>

<style>
  .plate-compare {
    margin: 1.5rem 0;
    padding: 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 12px;
    background: var(--lab-card-bg);
  }
  .plate-compare__panels {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .plate-compare__panel svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .plate-compare__label {
    margin: 0.5rem 0 0;
    font-size: 0.9rem;
    text-align: center;
  }
  .plate-compare__label strong {
    color: var(--sl-color-white);
  }
  .plate-compare__label span {
    margin-left: 0.25rem;
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
  }
  .plate-compare figcaption {
    margin-top: 0.85rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--sl-color-gray-5);
    font-size: 0.85rem;
    line-height: 1.65;
    color: var(--sl-color-gray-2);
    word-break: keep-all;
  }
  .plate-compare__note {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.78rem;
    color: var(--sl-color-gray-3);
  }
  .plate-material {
    fill: color-mix(in srgb, var(--plate-accent) 12%, var(--lab-card-bg));
  }
  .plate-mesh {
    fill: none;
    stroke: color-mix(in srgb, var(--plate-accent) 55%, var(--sl-color-gray-3));
    stroke-width: 1;
    stroke-linejoin: round;
  }
  .plate-boundary {
    fill: none;
    stroke: var(--sl-color-white);
    stroke-width: 2.5;
    stroke-linejoin: round;
  }
  :global(:root[data-theme='dark']) .plate-material {
    fill: color-mix(in srgb, var(--plate-accent) 22%, var(--lab-card-bg));
  }
  :global(:root[data-theme='dark']) .plate-mesh {
    stroke: color-mix(in srgb, var(--plate-accent) 45%, var(--sl-color-gray-2));
  }
  @media (max-width: 600px) {
    .plate-compare {
      padding: 0.75rem;
    }
    .plate-compare__panels {
      grid-template-columns: 1fr;
    }
  }
</style>
