---
// 세로 흐름도: 단계 목록을 화살표로 이어 보여 준다.
// 사용법 (MDX): <FlowSteps label="…" steps={[{ title: '현실의 문제', en: 'Problem' }, …]} />
interface Step {
  title: string;
  en?: string;
}

interface Props {
  steps: Step[];
  /** 접근성 라벨 (그림 설명) */
  label: string;
  accent?: string;
}

const { steps, label, accent = 'var(--sl-color-accent)' } = Astro.props;
---

<figure class="flow not-content" style={`--flow-accent: ${accent}`}>
  <ol aria-label={label}>
    {steps.map((step, i) => (
      <li>
        <span class="flow__num" aria-hidden="true">{i + 1}</span>
        <span class="flow__text">
          <strong>{step.title}</strong>
          {step.en && <span lang="en">{step.en}</span>}
        </span>
      </li>
    ))}
  </ol>
</figure>

<style>
  .flow {
    margin: 1.5rem auto;
    max-width: 26rem;
  }
  .flow ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .flow li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 10px;
    background: var(--sl-color-bg);
  }
  .flow li + li {
    margin-top: 1.9rem;
  }
  /* 단계 사이 화살표 */
  .flow li + li::before {
    content: '';
    position: absolute;
    top: -1.65rem;
    left: 50%;
    width: 2px;
    height: 1.1rem;
    background: var(--flow-accent);
    transform: translateX(-50%);
  }
  .flow li + li::after {
    content: '';
    position: absolute;
    top: -0.6rem;
    left: 50%;
    border: 0.36rem solid transparent;
    border-top-color: var(--flow-accent);
    border-bottom-width: 0;
    transform: translateX(-50%);
  }
  .flow__num {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--flow-accent) 15%, transparent);
    color: var(--flow-accent);
    font-size: 0.85rem;
    font-weight: 700;
  }
  :global(:root[data-theme='dark']) .flow__num {
    color: color-mix(in srgb, var(--flow-accent) 60%, white);
  }
  .flow__text {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.15rem 0.5rem;
  }
  .flow__text strong {
    color: var(--sl-color-white);
  }
  .flow__text span {
    font-size: 0.85rem;
    color: var(--sl-color-gray-3);
  }
</style>
