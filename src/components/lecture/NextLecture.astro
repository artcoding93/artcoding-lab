---
// 다음 강의 안내 카드. 안내 문장은 slot으로 받고, 공개 상태는 로드맵 데이터에서 읽는다.
// 다음 강의가 공개(published)되면 자동으로 링크가 생기고, 그 전에는 '준비 중'으로만 표시한다.
// 사용법 (MDX):
//   <NextLecture roadmap={numericalRoadmap} lectureId="what-is-numerical-analysis">…안내 문장…</NextLecture>
import { STATUSES, type RoadmapDef } from '../../lib/roadmap';
import { loadLecture, pad2 } from './load-lecture';

interface Props {
  roadmap: RoadmapDef;
  /** 현재 강의 id (다음 강의는 로드맵 순서로 찾는다) */
  lectureId: string;
}

const { roadmap, lectureId } = Astro.props;
const { next } = await loadLecture(roadmap, lectureId);
const roadmapHref = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}${roadmap.basePath}/`;
---

<aside class="next-lecture" aria-label="다음 강의 안내">
  <slot />
  {next && (
    <p class="next-lecture__status not-content">
      {next.isPublic && next.href ? (
        <a class="next-lecture__link" href={next.href}>Lecture {pad2(next.number)} 바로 가기 →</a>
      ) : (
        <>
          <span class="next-lecture__badge">{STATUSES[next.status].label}</span>
          <span>Lecture {pad2(next.number)}은 아직 공개되지 않았습니다. 전체 목차는 <a href={roadmapHref}>로드맵</a>에서 볼 수 있습니다.</span>
        </>
      )}
    </p>
  )}
</aside>

<style>
  .next-lecture {
    margin-top: 1rem;
    padding: 0.25rem 1.25rem 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 12px;
  }
  .next-lecture__status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 1rem 0 0;
    padding-top: 0.85rem;
    border-top: 1px solid var(--sl-color-gray-5);
    font-size: 0.85rem;
    color: var(--sl-color-gray-2);
  }
  .next-lecture__badge {
    padding: 0.1rem 0.55rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--sl-color-gray-2);
  }
  .next-lecture__link {
    font-weight: 600;
  }
  @media (max-width: 600px) {
    .next-lecture {
      padding: 0.1rem 1rem 0.85rem;
    }
  }
</style>
