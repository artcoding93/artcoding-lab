---
// 수치해석 개념도 (직접 그린 SVG, 외부 이미지 없음). 색은 currentColor를 따른다.
// 수치해석 1강의 1.4(주요 분야)와 1.8(응용 분야) 카드에 사용한다.
const FIGURES = {
  /** 비선형 방정식: 곡선이 x축과 만나는 점(근) */
  roots: 'roots',
  /** 수치 선형대수: Ax = b */
  'linear-algebra': 'linear-algebra',
  /** 보간: 데이터 점을 지나는 곡선 */
  interpolation: 'interpolation',
  /** 수치 미분·적분: 곡선 아래 직사각형 근사와 접선 */
  calculus: 'calculus',
  /** 미분방정식: 시간 간격마다 해를 갱신 (점선은 정확한 해) */
  ode: 'ode',
  /** 구조해석·FEM: 요소로 나눈 보와 하중 */
  fem: 'fem',
  /** 유체·열전달: 원기둥 주위의 유선 */
  fluid: 'fluid',
  /** 광학·파동: 두 점광원의 파면과 스크린 */
  optics: 'optics',
  /** 메시 생성: 영역을 삼각형 요소로 분할 */
  mesh: 'mesh',
} as const;

interface Props {
  name: keyof typeof FIGURES;
}

const { name } = Astro.props;
if (!(name in FIGURES)) throw new Error(`[ConceptIcon] 알 수 없는 그림: ${name}`);

// 메시 그림의 꼭짓점과 삼각형
const P: Record<string, [number, number]> = {
  p0: [14, 60], p1: [40, 66], p2: [70, 64], p3: [104, 56], p4: [100, 28], p5: [72, 14], p6: [40, 16], p7: [16, 32],
  q0: [38, 40], q1: [62, 38], q2: [84, 40],
};
const TRIANGLES = [
  ['p0', 'p1', 'q0'], ['p0', 'q0', 'p7'], ['p7', 'q0', 'p6'], ['p6', 'q0', 'q1'], ['p6', 'q1', 'p5'], ['p5', 'q1', 'q2'],
  ['p5', 'q2', 'p4'], ['p4', 'q2', 'p3'], ['p3', 'q2', 'p2'], ['p2', 'q2', 'q1'], ['p2', 'q1', 'p1'], ['p1', 'q1', 'q0'],
];
const meshPath = TRIANGLES.map((t) => `M${t.map((k) => P[k].join(',')).join('L')}Z`).join('');
const halfArc = (cx: number, cy: number, r: number) => `M${cx},${cy - r}A${r},${r} 0 0 1 ${cx},${cy + r}`;
---

<svg viewBox="0 0 120 80" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" role="presentation">
  {name === 'roots' && (
    <>
      <path d="M8 50H112M20 8V74" stroke-width="1.2" opacity="0.45" />
      <path d="M14 72C38 70 54 56 65 50S92 22 110 10" />
      <circle cx="65" cy="50" r="4" fill="currentColor" stroke="none" />
    </>
  )}
  {name === 'linear-algebra' && (
    <>
      <path d="M16 12h-4v56h4M54 12h4v56h-4" />
      {[0, 1, 2].flatMap((r) => [0, 1, 2].map((c) => <rect x={18 + c * 12} y={18 + r * 16} width="9" height="9" rx="1.5" fill="currentColor" stroke="none" opacity={r === c ? 0.85 : 0.35} />))}
      <path d="M66 12h-2v56h2M78 12h2v56h-2" />
      {[0, 1, 2].map((r) => <rect x="67.5" y={18 + r * 16} width="9" height="9" rx="1.5" />)}
      <path d="M86 36h8M86 44h8" />
      <path d="M100 12h-2v56h2M112 12h2v56h-2" />
      {[0, 1, 2].map((r) => <rect x="101.5" y={18 + r * 16} width="9" height="9" rx="1.5" fill="currentColor" stroke="none" opacity="0.6" />)}
    </>
  )}
  {name === 'interpolation' && (
    <>
      <path d="M8 70H112" stroke-width="1.2" opacity="0.45" />
      <path d="M15 58C22 45 27 30 35 30C45 30 50 46 58 44C67 42 72 22 80 22C90 22 98 34 105 36" />
      {[[15, 58], [35, 30], [58, 44], [80, 22], [105, 36]].map(([x, y]) => <circle cx={x} cy={y} r="3.5" fill="currentColor" stroke="none" />)}
    </>
  )}
  {name === 'calculus' && (
    <>
      <path d="M8 66H112M14 8V74" stroke-width="1.2" opacity="0.45" />
      {[[30, 54], [41, 50], [52, 45], [63, 39], [74, 32]].map(([x, top]) => <rect x={x} y={top} width="11" height={66 - top} fill="currentColor" stroke="none" opacity="0.22" />)}
      <path d="M16 60C42 58 72 30 108 14" />
      <path d="M70 46L102 20" stroke-dasharray="4 3" stroke-width="1.5" />
    </>
  )}
  {name === 'ode' && (
    <>
      <path d="M8 70H112M14 8V74" stroke-width="1.2" opacity="0.45" />
      <path d="M18 62C45 60 70 40 108 14" stroke-dasharray="4 3" stroke-width="1.5" opacity="0.7" />
      <path d="M18 62L36 59L54 52L72 42L90 30L108 18" />
      {[[18, 62], [36, 59], [54, 52], [72, 42], [90, 30], [108, 18]].map(([x, y]) => <circle cx={x} cy={y} r="3" fill="currentColor" stroke="none" />)}
    </>
  )}
  {name === 'fem' && (
    <>
      <path d="M8 22V62M8 26l-4 4M8 36l-4 4M8 46l-4 4M8 56l-4 4" stroke-width="1.5" opacity="0.7" />
      <path d="M10 30H106V54H10ZM34 30V54M58 30V54M82 30V54M10 54L34 30M34 54L58 30M58 54L82 30M82 54L106 30" stroke-width="1.6" />
      <path d="M106 6V24M100 18l6 6l6-6" />
    </>
  )}
  {name === 'fluid' && (
    <>
      <circle cx="60" cy="40" r="11" fill="currentColor" fill-opacity="0.22" />
      <path d="M8 12C40 12 48 10 60 10C72 10 80 12 112 12" stroke-width="1.6" />
      <path d="M8 26C38 26 46 22 60 22C74 22 82 26 112 26" stroke-width="1.6" />
      <path d="M8 54C38 54 46 58 60 58C74 58 82 54 112 54" stroke-width="1.6" />
      <path d="M8 68C40 68 48 70 60 70C72 70 80 68 112 68" stroke-width="1.6" />
      <path d="M8 40H44M76 40H112" stroke-width="1.6" />
      <path d="M106 8l6 4l-6 4M106 36l6 4l-6 4M106 64l6 4l-6 4" stroke-width="1.6" />
    </>
  )}
  {name === 'optics' && (
    <>
      {[10, 22, 34, 46].map((r) => <path d={halfArc(22, 30, r)} stroke-width="1.3" opacity="0.55" />)}
      {[10, 22, 34, 46].map((r) => <path d={halfArc(22, 50, r)} stroke-width="1.3" opacity="0.55" />)}
      <circle cx="22" cy="30" r="3.5" fill="currentColor" stroke="none" />
      <circle cx="22" cy="50" r="3.5" fill="currentColor" stroke="none" />
      <path d="M110 6V74" stroke-width="2.5" />
      {[16, 28, 40, 52, 64].map((y) => <circle cx="110" cy={y} r="2.6" fill="currentColor" stroke="none" />)}
    </>
  )}
  {name === 'mesh' && (
    <>
      <path d={meshPath} stroke-width="1.3" />
      {Object.values(P).map(([x, y]) => <circle cx={x} cy={y} r="2.2" fill="currentColor" stroke="none" />)}
    </>
  )}
</svg>
