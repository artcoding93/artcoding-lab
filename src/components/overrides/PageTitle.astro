---
// Starlight PageTitle 오버라이드 (astro.config.mjs의 starlight({ components: { PageTitle } })로 등록)
// - 홈(/)에서만 영문 소개 문구와 슬로건 H1을 출력한다. 헤더 로고 'artcoding Lab'과 제목이 겹치지 않게 하기 위함이다.
// - 다른 모든 페이지는 Starlight 기본 PageTitle(frontmatter title을 H1으로 출력)을 그대로 사용한다.
// - SEO의 <title>·description·canonical은 frontmatter에서 만들어지므로 이 컴포넌트와 무관하다.
import Default from '@astrojs/starlight/components/PageTitle.astro';

const isHome = Astro.locals.starlightRoute.id === '';
---

{
  isHome ? (
    <div class="home-title">
      <p class="home-title__eyebrow" lang="en">
        Computational Science &amp; Engineering
      </p>
      {/* id="_top"은 Starlight 기본 제목과 같은 값 (목차·건너뛰기 링크 대상) */}
      <h1 id="_top" class="home-title__h1">
        공학을 코드로 이해하다.
      </h1>
    </div>
  ) : (
    <Default />
  )
}

<style>
  .home-title__eyebrow {
    margin: 0;
    color: var(--lab-navy);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .home-title__h1 {
    margin: 0.3rem 0 0;
    color: var(--sl-color-white);
    font-size: clamp(1.5rem, 1.2rem + 1vw, 1.9rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
    word-break: keep-all;
  }
</style>
