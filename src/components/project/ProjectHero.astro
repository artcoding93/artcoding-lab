---
// 프로젝트 페이지 상단 소개 블록 (제목 + 한 줄 설명 + 분야 아이콘)
// 사용법 (MDX):
//   <ProjectHero title="Build Your Own Quantum Simulator" description="..." accent="#16a34a">
//     <svg slot="icon" ...>...</svg>
//   </ProjectHero>
interface Props {
  title: string;
  description: string;
  /** 분야 강조 색상 (CLAUDE.md 7절: 수치해석 #2563eb, FEM #9333ea, 양자컴퓨팅 #16a34a) */
  accent?: string;
}

const { title, description, accent = 'var(--sl-color-accent)' } = Astro.props;
---

<header class="pj-hero not-content" style={`--hero-accent: ${accent}`}>
  {
    Astro.slots.has('icon') && (
      <span class="pj-hero__icon" aria-hidden="true">
        <slot name="icon" />
      </span>
    )
  }
  <div>
    <p class="pj-hero__title">{title}</p>
    <p class="pj-hero__desc">{description}</p>
  </div>
</header>

<style>
  .pj-hero {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    margin: 0 0 1.5rem;
    padding: 1.25rem 1.4rem;
    border: 1px solid var(--sl-color-gray-5);
    border-left: 4px solid var(--hero-accent);
    border-radius: 14px;
    background: var(--sl-color-bg-nav);
  }
  :global(:root[data-theme='light']) .pj-hero {
    background: var(--sl-color-gray-7);
  }
  .pj-hero__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 12px;
    background: color-mix(in srgb, var(--hero-accent) 16%, transparent);
    color: var(--hero-accent);
  }
  .pj-hero__icon :global(svg) {
    width: 1.9rem;
    height: 1.9rem;
  }
  .pj-hero__title {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--sl-color-white);
  }
  .pj-hero__desc {
    margin: 0.35rem 0 0;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--sl-color-gray-2);
    word-break: keep-all;
  }
  @media (max-width: 600px) {
    .pj-hero {
      flex-direction: column;
      align-items: flex-start;
      padding: 1rem;
    }
    .pj-hero__title {
      font-size: 1.15rem;
    }
  }
</style>
