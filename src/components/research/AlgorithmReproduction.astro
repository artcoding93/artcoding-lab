---
// Algorithm Reproduction: Stage별 재현 대상 알고리즘 + 계획된 인터랙티브 Explorer
import { ALGORITHM_STATUSES, EXPERIMENT_STATUSES, PAPER_STATUSES, type ResearchDef } from '../../lib/research';
import { loadResearch } from './load-research';
import './research.css';

interface Props {
  research: ResearchDef;
  /** 'algorithms' | 'explorers' */
  show: 'algorithms' | 'explorers';
}

const { research, show } = Astro.props;
const r = await loadResearch(research);
const base = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}${r.basePath}`;
const algorithmOf = new Map(r.algorithms.map((a) => [a.id, a]));
const experimentOf = new Map(r.experiments.map((x) => [x.id, x]));
const groups = r.stages.filter((s) => s.algorithmIds.length);
---

{show === 'algorithms' ? (
  <div class="rs not-content">
    <p class="rs-alg__summary">
      재현 완료 <strong>{r.stats.algorithms.reproduced}</strong> / {r.stats.algorithms.total} · 아직 구현된 알고리즘이 없으면 모두 '계획'으로 표시됩니다.
    </p>
    {groups.map((s) => (
      <section class="rs-alg__group">
        <h3 class="rs-alg__stage"><a href={`${base}/roadmap/#stage-${s.id}`}>Stage {s.number}</a> · {s.title}</h3>
        <ul class="rs-grid">
          {s.algorithmIds.map((id) => {
            const a = algorithmOf.get(id)!;
            return (
              <li class="rs-card rs-alg" id={`alg-${a.id}`}>
                <div class="rs-alg__head">
                  <h4>{a.name}</h4>
                  <span class="rs-badge" data-s={a.status}>{ALGORITHM_STATUSES[a.status].label}</span>
                </div>
                <p class="rs-alg__desc">{a.summary}</p>
                <p class="rs-alg__meta">
                  <span class="rs-tag">{a.scope === 'reproduction' ? '원 논문 재현' : '교육·연구용 단순화 구현'}</span>
                  {a.comparison && <span class="rs-tag">비교 연구</span>}
                </p>
                <p class="rs-alg__row">
                  <span class="rs-alg__key">논문</span>
                  {a.paperIds.map((pid) => (
                    <a href={`${base}/papers/#paper-${pid}`}>{r.paper.get(pid)!.cite} <span class="rs-badge" data-s={r.paper.get(pid)!.status}>{PAPER_STATUSES[r.paper.get(pid)!.status].label}</span></a>
                  ))}
                </p>
                <p class="rs-alg__row">
                  <span class="rs-alg__key">코드</span>
                  {a.codeHref ? <a href={a.codeHref}>{a.code}</a> : <span class="rs-muted">아직 없음</span>}
                </p>
                {a.experimentIds.length > 0 && (
                  <p class="rs-alg__row">
                    <span class="rs-alg__key">실험</span>
                    {a.experimentIds.map((xid) => (
                      <a href={`${base}/experiments/#exp-${xid}`}>{experimentOf.get(xid)!.title} <span class="rs-badge" data-s={experimentOf.get(xid)!.status}>{EXPERIMENT_STATUSES[experimentOf.get(xid)!.status].label}</span></a>
                    ))}
                  </p>
                )}
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </div>
) : (
  <ul class="rs rs-grid not-content">
    {r.explorers.map((e) => (
      <li class="rs-card rs-card--dashed rs-alg">
        <div class="rs-alg__head">
          <h4><code>{e.name}</code></h4>
          <span class="rs-badge" data-s={e.status}>{ALGORITHM_STATUSES[e.status].label}</span>
        </div>
        <ol class="rs-alg__steps">
          {e.features.map((f) => <li>{f}</li>)}
        </ol>
        <p class="rs-alg__row">
          <span class="rs-alg__key">연결</span>
          {e.algorithmIds.map((id) => <a href={`#alg-${id}`}>{algorithmOf.get(id)!.name}</a>)}
        </p>
      </li>
    ))}
  </ul>
)}

<style>
  .rs-alg__summary {
    margin: 0;
    font-size: 0.9rem;
    color: var(--rs-muted);
  }
  .rs-alg__summary strong {
    color: var(--sl-color-white);
  }
  .rs-alg__group {
    margin-top: 1.5rem;
  }
  .rs-alg__stage {
    margin: 0;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--rs-border);
    font-size: 1rem;
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .rs-alg__stage a {
    text-decoration: none;
  }
  .rs-alg {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .rs-alg__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
  }
  .rs-alg__head h4 {
    margin: 0;
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .rs-alg__desc {
    margin: 0;
    font-size: 0.87rem;
    line-height: 1.6;
    word-break: keep-all;
  }
  .rs-alg__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0;
  }
  .rs-alg__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 0.7rem;
    margin: 0;
    font-size: 0.83rem;
  }
  .rs-alg__row a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    text-decoration: none;
  }
  .rs-alg__row a:hover {
    text-decoration: underline;
  }
  .rs-alg__key {
    min-width: 2rem;
    font-weight: 600;
    color: var(--rs-muted);
  }
  .rs-alg__steps {
    margin: 0;
    padding-left: 1.2rem;
    font-size: 0.87rem;
    line-height: 1.65;
  }
</style>
