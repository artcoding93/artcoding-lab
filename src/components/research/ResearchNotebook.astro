---
// Research Notebook: 노트 유형 · 노트 목록 (작성일 역순, 관련 논문·알고리즘·노트 연결)
import { NOTE_TYPES, type NoteTypeId, type ResearchDef } from '../../lib/research';
import { loadResearch } from './load-research';
import './research.css';

interface Props {
  research: ResearchDef;
  show: 'types' | 'notes';
}

const { research, show } = Astro.props;
const r = await loadResearch(research);
const base = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}${r.basePath}`;
const types = Object.entries(NOTE_TYPES) as [NoteTypeId, (typeof NOTE_TYPES)[NoteTypeId]][];
const count = (t: NoteTypeId) => r.notes.filter((n) => n.type === t).length;
const noteOf = new Map(r.notes.map((n) => [n.id, n]));
const algorithmOf = new Map(r.algorithms.map((a) => [a.id, a]));
---

{show === 'types' ? (
  <ul class="rs rs-grid rs-nb__types not-content">
    {types.map(([id, t]) => (
      <li class="rs-card">
        <p class="rs-nb__type">{t.label} <span class="rs-muted">· {count(id)}</span></p>
        <p class="rs-nb__desc">{t.ko}</p>
      </li>
    ))}
  </ul>
) : r.notes.length ? (
  <ul class="rs rs-list not-content">
    {r.notes.map((n) => (
      <li class="rs-card rs-nb__note" id={`note-${n.id}`}>
        <p class="rs-nb__meta"><span class="rs-tag">{NOTE_TYPES[n.type].label}</span> <time datetime={n.date}>{n.date}</time></p>
        <h4><a href={n.href}>{n.title}</a></h4>
        <p class="rs-nb__links">
          {n.paperIds?.map((id) => <a href={`${base}/papers/#paper-${id}`}>{r.paper.get(id)!.cite}</a>)}
          {n.algorithmIds?.map((id) => <a href={`${base}/algorithms/#alg-${id}`}>{algorithmOf.get(id)!.name}</a>)}
          {n.relatedNoteIds?.map((id) => <a href={noteOf.get(id)!.href}>↔ {noteOf.get(id)!.title}</a>)}
        </p>
      </li>
    ))}
  </ul>
) : (
  <p class="rs not-content rs-empty">
    아직 작성된 연구 노트가 없습니다. 첫 논문 리뷰와 재현 구현을 진행하면서 관찰한 한계, 실패 사례, 가설을 노트로 기록합니다.
  </p>
)}

<style>
  .rs-nb__type {
    margin: 0;
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .rs-nb__desc {
    margin: 0.3rem 0 0;
    font-size: 0.87rem;
    line-height: 1.55;
    word-break: keep-all;
  }
  .rs-nb__note + .rs-nb__note {
    margin-top: 0.6rem;
  }
  .rs-nb__meta {
    margin: 0;
    font-size: 0.78rem;
    color: var(--rs-muted);
  }
  .rs-nb__note h4 {
    margin: 0.35rem 0 0;
    font-size: 1rem;
  }
  .rs-nb__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.8rem;
    margin: 0.45rem 0 0;
    font-size: 0.82rem;
  }
</style>
