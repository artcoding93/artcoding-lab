---
// Research Lab 메인: 연구 현황 요약 + 다섯 영역(로드맵·논문·재현·실험·노트) 바로가기 + Stage 요약
import { STAGE_STATUSES, type ResearchDef } from '../../lib/research';
import { loadResearch } from './load-research';
import './research.css';

interface Props {
  research: ResearchDef;
}

const r = await loadResearch(Astro.props.research);
const base = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}${r.basePath}`;
const { stats } = r;
const areas = [
  { key: 'A', title: 'Research Roadmap', ko: '연구 로드맵', href: `${base}/roadmap/`, desc: '시대별 혁신적인 메시 생성 알고리즘과 9개 연구 Stage', stat: `${r.stages.length}개 Stage` },
  { key: 'B', title: 'Paper Library', ko: '논문 라이브러리', href: `${base}/papers/`, desc: '원 논문의 서지정보, 핵심 기여, 선행·후속 연구', stat: `등록 ${stats.papers}편 · 리뷰 완료 ${stats.reviewed}편` },
  { key: 'C', title: 'Algorithm Reproduction', ko: '알고리즘 재현', href: `${base}/algorithms/`, desc: '논문의 알고리즘을 Python으로 직접 구현하고 시각화', stat: `재현 ${stats.algorithms.reproduced} / ${stats.algorithms.total}` },
  { key: 'D', title: 'Benchmark & Experiments', ko: '벤치마크와 실험', href: `${base}/experiments/`, desc: '공통 형상에서 품질·속도·강건성 비교', stat: `완료 ${stats.experiments.completed} / ${stats.experiments.total}` },
  { key: 'E', title: 'Research Notebook', ko: '연구 노트', href: `${base}/notebook/`, desc: '한계·실패 사례·개선 아이디어·연구 가설의 축적', stat: `노트 ${stats.notes}개` },
];
---

<div class="rs not-content">
  <ol class="rs-ov__areas">
    {areas.map((a) => (
      <li>
        <a class="rs-card rs-ov__area" href={a.href}>
          <span class="rs-ov__key">{a.key}</span>
          <span class="rs-ov__title">{a.title}</span>
          <span class="rs-ov__ko">{a.ko}</span>
          <span class="rs-ov__desc">{a.desc}</span>
          <span class="rs-ov__stat">{a.stat}</span>
        </a>
      </li>
    ))}
  </ol>

  <ol class="rs-ov__stages" aria-label="연구 Stage 요약">
    {r.stages.map((s) => (
      <li data-open-ended={s.openEnded ? '' : undefined}>
        <a href={`${base}/roadmap/#stage-${s.id}`}>
          <span class="rs-ov__snum">{s.number}</span>
          <span class="rs-ov__stext">
            <span class="rs-ov__sname">{s.title}</span>
            <span class="rs-ov__smeta">논문 {s.paperIds.length} · 재현 {s.algorithmIds.length} · 실험 {s.experimentIds.length}</span>
          </span>
          <span class="rs-badge" data-s={s.status}>{STAGE_STATUSES[s.status].label}</span>
        </a>
      </li>
    ))}
  </ol>
</div>

<style>
  .rs-ov__areas {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .rs-ov__area {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    height: 100%;
    color: inherit !important;
    text-decoration: none;
    transition: border-color 0.15s;
  }
  .rs-ov__area:hover {
    border-color: var(--rs-accent);
  }
  .rs-ov__area:focus-visible {
    outline: 2px solid var(--rs-accent);
    outline-offset: 2px;
  }
  .rs-ov__key {
    font-family: var(--sl-font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--rs-accent);
  }
  .rs-ov__title {
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .rs-ov__ko {
    font-size: 0.82rem;
    color: var(--rs-muted);
  }
  .rs-ov__desc {
    margin-top: 0.35rem;
    font-size: 0.86rem;
    line-height: 1.55;
    word-break: keep-all;
  }
  .rs-ov__stat {
    margin-top: auto;
    padding-top: 0.5rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--rs-muted);
  }
  .rs-ov__stages {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .rs-ov__stages a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.3rem 0.6rem;
    align-content: start;
    height: 100%;
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--rs-border);
    border-top: 3px solid var(--rs-accent);
    border-radius: 10px;
    color: inherit;
    text-decoration: none;
  }
  [data-open-ended] a {
    border-top-style: dashed;
  }
  .rs-ov__stages a:hover {
    background: var(--rs-surface);
  }
  .rs-ov__stages .rs-badge {
    grid-column: 2;
    justify-self: start;
  }
  .rs-ov__snum {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--rs-surface);
    font-size: 0.78rem;
    font-weight: 700;
  }
  .rs-ov__stext {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .rs-ov__sname {
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--sl-color-white);
  }
  .rs-ov__smeta {
    font-size: 0.74rem;
    color: var(--rs-muted);
  }
  @media (max-width: 900px) {
    .rs-ov__areas,
    .rs-ov__stages {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .rs-ov__areas,
    .rs-ov__stages {
      grid-template-columns: 1fr;
    }
  }
</style>
